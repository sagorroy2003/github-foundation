# =============================================================================
# .gitignore — Node.js + C++ workspace
# =============================================================================

# -----------------------------------------------------------------------
# Node.js
# -----------------------------------------------------------------------
# Runtime & package manager artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Note: package-lock.json is intentionally NOT ignored so that
# `npm ci` in CI can use it for reproducible installs.
yarn.lock
pnpm-lock.yaml

# Environment variables (never commit secrets)
.env
.env.*
!.env.example

# Build output
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/

# Coverage & test reports
coverage/
.nyc_output/

# OS / editor artefacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# -----------------------------------------------------------------------
# C++
# -----------------------------------------------------------------------
# Compiled object files
*.o
*.obj

# Compiled binaries / executables
*.out
*.exe
*.app
a.out

# Static and shared libraries
*.a
*.lib
*.so
*.dylib
*.dll

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake

# Debug / profiling files
*.dSYM/
*.su
*.idb
*.pdb

# Dependency managers (Conan, vcpkg)
conan.lock
conanbuildinfo.txt
conanbuildinfo.cmake
graph_info.json
vcpkg_installed/
